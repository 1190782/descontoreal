# Copia para .env e preenche. O .env nunca vai para o git.

# Postgres do Supabase: Connect > Session pooler (funciona em IPv4, necessário no GitHub Actions).
# Usado pelos scrapers, pelos jobs diários e pelas migrações.
DATABASE_URL=

# Email ao administrador quando um scraper parece partido (Resend). Opcional na fase 0.
RESEND_API_KEY=
ADMIN_EMAIL=
EMAIL_FROM=

# Site (fase 2): rota protegida de revalidação chamada no fim de cada loja.
SITE_URL=
REVALIDATE_SECRET=
