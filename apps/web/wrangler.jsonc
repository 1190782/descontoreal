{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "descontoreal-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "descontoreal-web",
    },
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "escontoreal-next-cache",
    },
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "descontoreal-next-tags",
      "database_id": "8852d340-1d93-469d-8e4f-ea9fd5742c26",
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // descontoreal-db: the web_ro role through Supabase's Session pooler, caching off.
      "id": "d6d66bf053cb4a9b9f393427cdb03b97",
      // next dev: the local PGlite database (pnpm db:local).
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54329/postgres",
    },
  ],
  // The site's address: Cloudflare creates its DNS record and certificate on deploy.
  "routes": [
    {
      "pattern": "descontoreal.pt",
      "custom_domain": true,
    },
  ],
  // Stays on until descontoreal.pt is checked, then goes, so the site has one address.
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "upload_source_maps": true,
}
