{
  "name": "@descontoreal/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm cf:typegen && next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "pnpm cf:typegen && next typegen && tsc --noEmit -p .",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@descontoreal/core": "workspace:*",
    "@descontoreal/db": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.13",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.3",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.153.0"
  }
}
